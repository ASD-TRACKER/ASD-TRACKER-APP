rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regular team member — displayName sentinel set on PIN login.
    // Includes both team members AND admins (admin sentinel also satisfies this).
    function isTeamMember() {
      return request.auth != null && (
        request.auth.token.name == "asd-hub-member" ||
        request.auth.token.name == "asd-hub-admin"
      );
    }

    // Admin only — set when a member with role:"admin" logs in via PIN.
    function isAdminMember() {
      return request.auth != null && request.auth.token.name == "asd-hub-admin";
    }

    // Core app state — asd_invoices is admin-only at the data layer.
    // UI also gates the invoices tab with isAdmin(), but this enforces it
    // at Firestore so non-admin team members cannot access invoice data directly.
    match /appState/{document} {
      allow read: if request.auth != null && (document != "asd_invoices" || isAdminMember());
      allow write: if (isTeamMember() && document != "asd_invoices") || isAdminMember();
    }

    // Real-time online presence — per-user documents
    match /asd_online/{document} {
      allow read: if request.auth != null;
      allow write: if isTeamMember();
    }

    // Projects
    match /projects/{document} {
      allow read: if request.auth != null;
      allow write: if isTeamMember();
    }

    // Calendar events — per-event documents, shared across all members
    match /calendar_events/{document} {
      allow read: if request.auth != null;
      allow write: if isTeamMember();
    }

    // Tasks — per-task documents
    match /tasks/{document} {
      allow read: if request.auth != null;
      allow write: if isTeamMember();
    }

    // Feedback / client messages
    match /feedback/{document} {
      allow read: if request.auth != null;
      allow write: if isTeamMember();
    }

    // Notice board
    match /notices/{document} {
      allow read: if request.auth != null;
      allow write: if isTeamMember();
    }

    // Google Calendar OAuth tokens
    match /googleTokens/{document} {
      allow read: if request.auth != null;
      allow write: if isTeamMember();
    }

    // Public quote submissions
    match /quotes/{document} {
      allow create: if true;
      allow read, delete: if isTeamMember();
    }
  }
}
