rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Core app state — all authenticated users can read/write any appState key.
    // Access control is enforced at the app layer (UI gating + Railway Admin SDK proxy).
    // Restricting asd_invoices at the Firestore level caused permission errors that
    // triggered the reconciliation bug and caused invoice status reverts.
    match /appState/{document} {
      allow read, write: if request.auth != null;
    }

    // Real-time online presence
    match /asd_online/{document} {
      allow read, write: if request.auth != null;
    }

    // Projects
    match /projects/{document} {
      allow read, write: if request.auth != null;
    }

    // Calendar events
    match /calendar_events/{document} {
      allow read, write: if request.auth != null;
    }

    // Tasks
    match /tasks/{document} {
      allow read, write: if request.auth != null;
    }

    // Feedback / client messages
    match /feedback/{document} {
      allow read, write: if request.auth != null;
    }

    // Notice board
    match /notices/{document} {
      allow read, write: if request.auth != null;
    }

    // Google Calendar OAuth tokens
    match /googleTokens/{document} {
      allow read, write: if request.auth != null;
    }

    // Public quote submissions
    match /quotes/{document} {
      allow create: if true;
      allow read, delete: if request.auth != null;
    }
  }
}
